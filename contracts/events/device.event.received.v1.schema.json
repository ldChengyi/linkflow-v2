{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://linkflow.dev/contracts/events/lf.v1.device.event.received",
    "title": "device.event.received v1",
    "description": "Emitted by the device-event-processor after a device.event.reported event has passed thing-model validation and has been persisted. Params contains only fields accepted by the current thing model event output definition.",
    "type": "object",
    "required": [
        "tenant_id",
        "product_id",
        "device_id",
        "tenant_slug",
        "product_key",
        "device_slug",
        "event_name",
        "params"
    ],
    "additionalProperties": false,
    "properties": {
        "tenant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "tenant_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "product_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "device_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
        },
        "event_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*$"
        },
        "params": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
                "^[a-z][a-z0-9_]*$": {
                    "oneOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "string",
                            "maxLength": 1024
                        },
                        {
                            "type": "object",
                            "additionalProperties": true
                        },
                        {
                            "type": "array"
                        }
                    ]
                }
            },
            "additionalProperties": false
        }
    }
}
