{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://linkflow.dev/contracts/events/lf.v1.device.event.reported",
    "title": "device.event.reported v1",
    "description": "Emitted when a device reports a business event through MQTT event/up/post. The payload carries the event name plus event-specific parameters.",
    "type": "object",
    "required": [
        "tenant_id",
        "product_id",
        "device_id",
        "tenant_slug",
        "product_key",
        "device_slug",
        "protocol",
        "event_name",
        "params"
    ],
    "additionalProperties": false,
    "properties": {
        "tenant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "tenant_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "product_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "device_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
        },
        "protocol": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "event_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Thing-model event identifier reported by the device."
        },
        "params": {
            "type": "object",
            "description": "Event-specific parameters. Names should match the product's thing model event definition.",
            "patternProperties": {
                "^[a-z][a-z0-9_]*$": {
                    "oneOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "string",
                            "maxLength": 1024
                        },
                        {
                            "type": "object",
                            "additionalProperties": true
                        },
                        {
                            "type": "array"
                        }
                    ]
                }
            },
            "additionalProperties": false
        },
        "raw": {
            "type": "object",
            "description": "Original protocol payload captured by the MQTT rule.",
            "additionalProperties": true
        }
    }
}
