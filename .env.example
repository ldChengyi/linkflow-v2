# ============================================================
# LinkFlow v2 - environment variables template
# ============================================================
# Copy this file to .env and fill in real values for local dev.
# .env is gitignored; do not commit it.
#
# Add new variables here ONLY when a service actually uses them.
# This file should reflect the current state of the project, not
# planned future variables.
# ============================================================

# --- Infrastructure connection (used by services that connect to them) ---

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=linkflow
POSTGRES_PASSWORD=linkflow123
POSTGRES_DB=linkflow

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BROKERS=localhost:19092

MQTT_HOST=localhost
MQTT_PORT=1883
