# ============================================================
# LinkFlow v2 - environment variables template
# ============================================================
# Copy this file to .env and fill in real values for local dev.
# .env is gitignored; do not commit it.
#
# Keep this file aligned with deploy/docker-compose.yml and the
# config loaders under service/*/internal/config.
# ============================================================

# --- Docker build args used by deploy/docker-compose.yml ---

GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.org
NPM_REGISTRY=https://registry.npmmirror.com

# --- Host ports exposed by compose ---

WEB_HTTP_PORT=80
BACKEND_HTTP_PORT=18080
EMQX_MQTT_PORT=1883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
REDPANDA_KAFKA_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_REST_PROXY_PORT=18082
REDPANDA_ADMIN_API_PORT=19644
REDPANDA_CONSOLE_PORT=8080
TIMESCALEDB_PORT=5432
REDIS_PORT=6379

# --- Shared infrastructure values ---
# Host-side addresses are for running Go services directly on the host.
# Compose services use service DNS names such as timescaledb, redis, redpanda, emqx.

POSTGRES_USER=linkflow
POSTGRES_PASSWORD=linkflow123
POSTGRES_DB=linkflow
TS_TUNE_MEMORY=2GB
TS_TUNE_NUM_CPUS=2
POSTGRES_DSN=postgres://linkflow:linkflow123@127.0.0.1:5432/linkflow?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=10
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_CONN_MAX_IDLE_TIME=5m

REDIS_ADDR=127.0.0.1:6379
BACKEND_REDIS_ADDR=redis:6379
DEVICE_EVENT_PROCESSOR_REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_APPENDONLY=yes
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

KAFKA_BROKERS=127.0.0.1:19092
KAFKA_CONTAINER_BROKERS=redpanda:9092

# --- backend service ---

BACKEND_HTTP_ADDR=:18080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=5s
BACKEND_POSTGRES_DSN=postgres://linkflow:linkflow123@timescaledb:5432/linkflow?sslmode=disable

AUTH_ACCESS_TOKEN_SECRET=dev-only-linkflow-access-token-secret-change-before-production
AUTH_ACCESS_TOKEN_TTL=24h
AUTH_TOKEN_ISSUER=linkflow-backend
AUTH_BCRYPT_COST=12

MQTT_GATEWAY_USERNAME=linkflow-mqtt-gateway
MQTT_GATEWAY_PASSWORD=linkflow-mqtt-gateway-secret

REALTIME_GROUP_ID=
REALTIME_ACCESS_COOKIE=lf_access

# --- device-event-processor service ---

KAFKA_GROUP_ID=device-event-processor
CONSUMER_WORKERS=4
CONSUMER_BUFFER=128
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BACKOFF=200ms

DEVICE_ONLINE_TTL=120s

EMQX_API_URL=http://127.0.0.1:18083
EMQX_CONTAINER_API_URL=http://emqx:18083
EMQX_API_KEY=linkflow-init
EMQX_API_SECRET=linkflow-init-secret
EMQX_PUBLISH_TIMEOUT=3s

CONTRACTS_DIR=../../contracts
CONTRACTS_CONTAINER_DIR=/app/contracts
DEVICE_EVENT_PROCESSOR_POSTGRES_DSN=postgres://linkflow:linkflow123@timescaledb:5432/linkflow?sslmode=disable

# --- emqx-init service ---
# These are the compose-internal defaults used by deploy/init-scripts/emqx.

BACKEND_AUTH_URL=http://backend:18080/internal/emqx/auth
KAFKA_CONTAINER_BOOTSTRAP=redpanda:9092
KAFKA_TOPIC=lf.v1.device.events

# --- EMQX broker service ---

EMQX_NAME=linkflow-emqx
EMQX_HOST=127.0.0.1
EMQX_DASHBOARD__DEFAULT_USERNAME=admin
EMQX_DASHBOARD__DEFAULT_PASSWORD=public
EMQX_API_KEY__BOOTSTRAP_FILE=/opt/emqx/etc/default_api_key.conf
EMQX_ALLOW_ANONYMOUS=false

# --- redpanda-console service ---

KAFKA_SCHEMAREGISTRY_ENABLED=true
KAFKA_SCHEMAREGISTRY_URLS=http://redpanda:8081
REDPANDA_ADMINAPI_ENABLED=true
REDPANDA_ADMINAPI_URLS=http://redpanda:9644

# --- Redpanda broker service ---

REDPANDA_ADVERTISE_HOST=localhost
REDPANDA_RPC_PORT=33145
REDPANDA_SMP=1
REDPANDA_MEMORY=1G
REDPANDA_LOG_LEVEL=info

# --- Legacy mqtt-gateway service ---
# The current compose path is EMQX Rule Engine -> Redpanda -> device-event-processor.
# Keep these only for manually running the disabled legacy gateway.

MQTT_BROKER_URL=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=linkflow-mqtt-gateway
MQTT_USERNAME=linkflow-mqtt-gateway
MQTT_PASSWORD=linkflow-mqtt-gateway-secret
MQTT_CLEAN_SESSION=false
MQTT_MESSAGE_BUFFER=128
MQTT_WORKER_COUNT=4
MQTT_HANDLER_TIMEOUT=5s
KAFKA_BROKER_URL=127.0.0.1:19092
LF_TENANT_ID=default
LF_PRODUCER=mqtt-gateway
